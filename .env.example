# =============================================================================
# DAI-009: RAG Answer Quality Benchmark - Environment Configuration Template
# Copy this file to '.env' to configure local runtime settings.
# All secrets and API keys MUST be kept in environment variables, NEVER committed.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Mode Configuration ('offline' or 'online')
# -----------------------------------------------------------------------------
# - 'offline' (Default): Zero internet access, zero external API keys needed.
#   Uses DeterministicMockLLMProvider and DeterministicTestDoubleEmbeddingModel.
#   Guarantees 100% reproducible tests and benchmark baselines on Python 3.10-3.14.
# - 'online': Connects to real LLM and embedding providers via API.
RAG_MODE=offline

# -----------------------------------------------------------------------------
# 2. Retriever & Service Defaults
# -----------------------------------------------------------------------------
# Retrieval algorithm: 'lexical' (SQLite FTS5 BM25) or 'dense' (Cosine Similarity)
RAG_RETRIEVER_TYPE=lexical

# Default number of ranked context chunks to retrieve per question
RAG_TOP_K=3

# Optional custom database and document corpus file paths
# RAG_DB_PATH=db/rag_bench.db
# RAG_DOCS_PATH=data/sample_documents.json

# -----------------------------------------------------------------------------
# 3. Model Provider Selection
# -----------------------------------------------------------------------------
# LLM generator provider: 'mock' (default), 'openai', or 'gemini'
RAG_LLM_PROVIDER=mock

# Embedding provider for dense retrieval: 'mock' (default), 'openai', or 'sentence_transformers'
# Note: For Python 3.14, 'openai' API-based embeddings are recommended over PyTorch sentence-transformers.
RAG_EMBEDDING_PROVIDER=mock

# -----------------------------------------------------------------------------
# 4. OpenAI / OpenAI-Compatible Provider Credentials (when RAG_MODE=online)
# -----------------------------------------------------------------------------
# Required if RAG_LLM_PROVIDER=openai or RAG_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIM=1536

# -----------------------------------------------------------------------------
# 5. Gemini Provider Credentials (when RAG_LLM_PROVIDER=gemini)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# 6. Web Application Settings (Phase 2 Browser App)
# -----------------------------------------------------------------------------
# Host and port for 'python run_app.py' (defaults to 127.0.0.1:8000)
# RAG_APP_HOST=127.0.0.1
# RAG_APP_PORT=8000

# -----------------------------------------------------------------------------
# 7. Document Upload & Knowledge Base Settings (Phase 3)
# -----------------------------------------------------------------------------
# Dedicated directory where uploaded files (.txt, .md, .pdf) are safely stored
# RAG_UPLOAD_DIR=data/uploads
# Maximum allowed file upload size in bytes (defaults to 5242880 bytes / 5 MB)
# RAG_MAX_UPLOAD_SIZE_BYTES=5242880


